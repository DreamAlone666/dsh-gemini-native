{
  "name": "dsh-gemini-native",
  "version": "0.4.0",
  "private": true,
  "description": "Native Gemini API features for DeepSeek Harness: history replay, Google Search, XHigh, and Simplified Chinese system prompts.",
  "author": "DreamAlone",
  "license": "MIT",
  "homepage": "https://github.com/DreamAlone666/dsh-gemini-native#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DreamAlone666/dsh-gemini-native.git"
  },
  "bugs": {
    "url": "https://github.com/DreamAlone666/dsh-gemini-native/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "gemini",
    "google-search"
  ],
  "type": "module",
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.2 <0.3.0"
  },
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": "./src/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "scripts": {
    "test": "node --test",
    "test:integration": "node -e \"if (!process.env.DSH_INSTALL_DIR) throw new Error('Set DSH_INSTALL_DIR to the installed @deepseek-ai/dsh package directory')\" && node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-models"
      ]
    }
  }
}
