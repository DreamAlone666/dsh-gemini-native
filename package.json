{
  "name": "dsh-gemini-native",
  "version": "0.4.0",
  "private": true,
  "description": "Native Gemini API features for DeepSeek Harness: history replay, Google Search, XHigh, and Simplified Chinese system prompts.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.2 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "tool-prompts.js",
    "notice.js",
    "gemini-transport.js",
    "google-search-activity.js",
    "google-search-sse.js",
    "generate-content.js",
    "native-search-projection.js",
    "diagnostics-projection.js",
    "web-search-scope.js",
    "xhigh.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "scripts": {
    "test": "node --test",
    "test:integration": "node -e \"if (!process.env.DSH_INSTALL_DIR) throw new Error('Set DSH_INSTALL_DIR to the installed @deepseek-ai/dsh package directory')\" && node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-models"
      ]
    }
  }
}
